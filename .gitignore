macos/Flutter/ephemeral/
macos/Pods/
macos/.symlinks/
macos/.idea/
macos/Runner/GeneratedPluginRegistrant.*
*.xcworkspace
*.xcuserstate
*.xcuserdata/

# Web
lib/generated_plugin_registrant.dart
web/.dart_tool/
web/.idea/
web/build/

# Windows
windows/.dart_tool/
windows/Flutter/ephemeral/
